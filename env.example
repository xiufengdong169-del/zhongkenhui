# 众肯会服务号 v2 环境变量（复制为 .env，chmod 600，不进仓库）

# ---- 微信服务号 ----
WX_TOKEN=zonken2025
WX_APPID=wxe8f700245a3d2af7
WX_APPSECRET=填写服务号AppSecret

# ---- 数据库（独立库；分量字段，密码含特殊字符也安全）----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=zhongkenhui
DB_PASSWORD=填写数据库密码
DB_NAME=zhongkenhui

# ---- 管理员邮件通知（QQ 邮箱授权码）----
MAIL_ENABLED=1
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=32542256@qq.com
SMTP_PASS=填写QQ邮箱授权码
ADMIN_EMAIL=32542256@qq.com

# ---- 站点 ----
PUBLIC_BASE=http://wx.zk550.cn
LOG_FILE=/var/log/zhongkenhui/app.log

# ---- OAuth 网页授权 ----
# 需在微信公众平台「设置-公众号设置-功能设置-网页授权域名」配置 wx.zk550.cn 后才能开启
# 开启后用户在微信内访问 H5 页面时自动静默获取 OpenID
OAUTH_ENABLED=0

# ---- 微信模板消息（给管理员推送关注/取关/留言通知）----
# 管理员 OpenID（在公众号发一条消息即可从日志中查到）
WX_ADMIN_OPENID=oXoI-uGVf1nVFAu5Ad3dsuofYTwY
# 模板 ID（在公众平台「功能-模板消息」中申请后获得，审核通过后再填写）
WX_TEMPLATE_ID=
